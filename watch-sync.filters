# Stable filters for watch-sync-tray.ps1.
# If this file is changed after bisync has been initialized, run a one-time
# bisync --resync (preferably --dry-run first) before restarting the watcher.

# Windows and macOS filesystem metadata.
- [Tt]humbs.db
- [Dd]esktop.ini
- [Ee]hthumbs.db
- [Ee]hthumbs_vista.db
- .DS_Store
- .ds_store
- ._*
- .Spotlight-V100/**
- .Trashes/**
- .fseventsd/**

# Office lock files, editor swap files, and incomplete downloads.
- ~$*
- .~lock.*#
- *.[Tt][Mm][Pp]
- *.swp
- *.swo
- *.crdownload
- *.part

# Dropbox's local staging cache and per-machine metadata.
- .dropbox
- .dropbox.attr
- .dropbox.cache/**

# Python environments and generated bytecode.
- .venv/**
- __pycache__/**
- .pytest_cache/**
- .mypy_cache/**
- .ruff_cache/**
